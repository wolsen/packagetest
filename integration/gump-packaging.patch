+async def test_listener_does_not_apply_hidden_job_timeout(monkeypatch):
+    from gump.runner.lifecycle import run_listener_job
+    real_wait = asyncio.wait_for
+    timeouts = []
+    async def record_wait(awaitable, timeout):
+        timeouts.append(timeout)
+        return await real_wait(awaitable, timeout)
+    monkeypatch.setattr(asyncio, "wait_for", record_wait)
+    result = await run_listener_job(_FakeMachine("m"), runner_name="r", tenant="t", job_message={},
+                                    state=_FakeState(), labels="x", display="build", echo=lambda *a, **k: None)
+    assert result.result == "succeeded"
+    assert timeouts == [30]  # Runner startup only; workflow owner enforces the job deadline.
