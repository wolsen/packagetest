+def test_finalize_exports_durable_archive(tmp_path, monkeypatch):
+    import json
+    monkeypatch.setenv("GUMP_ARTIFACT_DIR", str(tmp_path))
+    store = ArtifactStore()
+    artifact = store.create(run_id="run", job_id="job", name="library", mime_type="application/zip")
+    store.stage_block(artifact, block_id="block", data=b"archive")
+    store.commit_blocklist(artifact, block_ids=["block"])
+    store.finalize(artifact, size=7, sha256=None)
+    del store
+    assert next(tmp_path.glob("*.zip")).read_bytes() == b"archive"
+    assert json.loads(next(tmp_path.glob("*.json")).read_text())["name"] == "library"
