+
+
+def test_deleted_tracked_file_is_not_synced(tmp_path):
+    import subprocess
+    from gump.gitutil import git_tracked_files
+    subprocess.run(["git", "init", str(tmp_path)], check=True, capture_output=True)
+    (tmp_path / "gone.txt").write_text("old")
+    subprocess.run(["git", "-C", str(tmp_path), "add", "gone.txt"], check=True)
+    (tmp_path / "gone.txt").unlink()
+    (tmp_path / "new.txt").write_text("new")
+    assert git_tracked_files(tmp_path) == ["new.txt"]
